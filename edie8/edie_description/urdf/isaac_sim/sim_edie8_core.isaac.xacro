<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find edie_description)/urdf/inertial_macros.xacro"/>
    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_length" value="0.029"/>
    <xacro:property name="wheel_separation" value="0.136"/>
    
    <material name="white">
	    <color rgba="1 1 1 1"/>
	</material>

	<material name="black">
	    <color rgba="0 0 0 1"/>
	</material>

    <link name="base_footprint">
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

	<link name="base_link">
	</link>

	<joint name="chassis_joint" type="fixed">
	    <parent link="base_link"/>
	    <child link="chassis"/>
	    <origin xyz="0 0 0"/>
	</joint>

	<link name="chassis">
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/collision/edie8_3_chassis.stl"/>
			</geometry>
			<material name="white"/>
		</visual>
		<collision>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/collision/edie8_3_chassis.stl"/>
			</geometry>
		</collision>
		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<mass value="1.9999701"/> 
			<inertia ixx="1.5095102e-02" ixy="0.0" ixz="7.5719359e-04" iyy="1.3006131e-02" iyz="0.0" izz="1.9568477e-02" />
		</inertial>
	</link>

	<!-- Display -->
	<link name="display">
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/visual/edie8_3_display.dae"/>
			</geometry>
			<material name="black"/>
		</visual>
		<collision>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/collision/edie8_3_display.stl"/>
			</geometry>
		</collision>
	</link>

	<joint name="display_joint" type="fixed">
		<parent link="chassis"/>
		<child link="display"/>
		<origin xyz="0.064 0 0.05" rpy="0 -2.44346 3.1415"/>
	</joint>

	<!--Left Ear-->

	<link name="left_ear">
		<visual>
			<origin xyz="0 0 0.01" rpy="0 0 0"/>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/visual/edie8_3_ear.dae"/>
			</geometry>
		</visual>
		<collision>
			<origin xyz="0 0 0.01" rpy="0 0 0"/>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/collision/edie8_3_ear.stl"/>
			</geometry>
		</collision>
		<xacro:inertial_sphere mass="0.001" radius="0.005">
			<origin xyz="0 0 0.01" rpy="0 0 0"/>
		</xacro:inertial_sphere>
	</link>

	<joint name="left_ear_joint" type="revolute">
		<parent link="chassis"/>
		<child link="left_ear"/>
		<origin xyz="-0.011 0.077 0.071" rpy="-0.79 -0.1 0"/>
		<axis xyz='0 0 1'/>
		<limit effort='2' lower='0' upper='1.0472' velocity='3.14'/>
	</joint>
	
	<!--Right Ear-->
	<link name="right_ear">
		<visual>
			<origin xyz="0 0 0.01" rpy="0 0 0"/>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/visual/edie8_3_ear.dae"/>
			</geometry>
		</visual>
		<collision>
			<origin xyz="0 0 0.01" rpy="0 0 0"/>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/collision/edie8_3_ear.stl"/>
			</geometry>
		</collision>
		<xacro:inertial_sphere mass="0.001" radius="0.005">
			<origin xyz="0 0 0.01" rpy="0 0 0"/>
		</xacro:inertial_sphere>
	</link>

	<joint name="right_ear_joint" type="revolute">
		<parent link="chassis"/>
		<child link="right_ear"/>
		<origin xyz="-0.011 -0.077 0.071" rpy="0.79 -0.1 0"/>
		<axis xyz='0 0 -1'/>
		<limit effort='2' lower='0' upper='1.0472' velocity='3.14'/>
	</joint>

	<!-- LEFT LEG -->
	<joint name="left_leg_joint" type="prismatic">
		<parent link="base_link"/>
		<child link="left_leg"/>
		<origin xyz="0.016 0.068 -0.012" rpy="0 0 0"/>
		<axis xyz="0 0 1"/>
		<limit lower="-0.2" upper="0" effort="20.0" velocity="0.2"/> 
		<dynamics damping="0.5" friction="0.1"/> 
	</joint>

	<link name="left_leg">
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/collision/edie8_3_left_leg.stl"/>
			</geometry>
		</visual>
		<collision>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/collision/edie8_3_left_leg.stl"/>
			</geometry>
		</collision>
		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<mass value="0.14695881"/> 
			<inertia ixx="1.1968607e-04" ixy="6.3793624e-06" ixz="1.3765656e-05" iyy="1.5602252e-04" iyz="-8.9374574e-06" izz="1.8119365e-04" />
		</inertial>
	</link>

	<joint name="left_wheel_joint" type="continuous">
		<parent link="left_leg"/>
		<child link="left_wheel"/>
		<origin xyz="0 0 0" rpy="-${pi / 2.0} 0 0"/>
		<dynamics damping="0.5" friction="0.1"/> 
		<axis xyz="0 0 1"/>
	</joint>

	<!-- LEFT WHEEL -->
	<link name="left_wheel">
		<visual>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/visual/edie8_3_wheel.dae"/>
			</geometry>
			<origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
			<!-- <material name="black"/> -->
		</visual>
		<collision>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/collision/edie8_3_wheel.stl"/>
			</geometry>
			<origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
			<!-- <material name="black"/> -->
		</collision>
		<inertial>
			<!-- <origin xyz="0 0 0" rpy="0 0 0"/-->
			<origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
			<mass value="0.03501343"/> 
			<inertia ixx="2.2839499e-05" ixy="0.0" ixz="0.0" iyy="4.2280867e-05" iyz="0.0" izz="2.2839494e-05" />
		</inertial>
	</link>


	<!-- RIGHT LEG -->
	<joint name="right_leg_joint" type="prismatic">
		<parent link="base_link"/>
		<child link="right_leg"/>
		<origin xyz="0.016 -0.068 -0.012" rpy="0 0 0"/>
		<axis xyz="0 0 1"/>
		<limit lower="-0.2" upper="0" effort="20.0" velocity="0.2"/> 
		<dynamics damping="0.5" friction="0.1"/> 
	</joint>

	<link name="right_leg">
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/collision/edie8_3_right_leg.stl"/>
			</geometry>
		</visual>
		<collision>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/collision/edie8_3_right_leg.stl"/>
			</geometry>
		</collision>
		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<mass value="0.14709504"/>
			<inertia ixx="1.1951894e-04" ixy="-6.3560006e-06" ixz="1.3718929e-05" iyy="1.5569796e-04" iyz="8.6462444e-06" izz="1.8135816e-04" />
		</inertial>
	</link>

	<joint name="right_wheel_joint" type="continuous">
		<parent link="right_leg"/>
		<child link="right_wheel"/>
		<origin xyz="0 0 0" rpy="-${pi / 2.0} 0 0"/>
		<dynamics damping="0.5" friction="0.1"/> 
		<axis xyz="0 0 1"/>
	</joint>

	<!-- RIGHT WHEEL -->
	<link name="right_wheel">
		<visual>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/visual/edie8_3_wheel.dae"/>
			</geometry>
			<origin xyz="0 0 0" rpy="-${pi / 2.0} 0 0"/>
			<!-- <material name="black"/> -->
		</visual>
		<collision>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/collision/edie8_3_wheel.stl"/>
			</geometry>
			<origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
			<!-- <material name="black"/> -->
		</collision>
		<inertial>
			<!-- <origin xyz="0 0 0" rpy="0 0 0"/> -->
			<origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
			<mass value="0.03501343"/> 
			<inertia ixx="2.2839499e-05" ixy="0.0" ixz="0.0" iyy="4.2280867e-05" iyz="0.0" izz="2.2839494e-05" />
		</inertial>
	</link>

	<!-- CASTER WHEEL -->
	<joint name="caster_wheel_joint" type="fixed">
		<parent link="base_link"/>
		<child link="caster_wheel"/>
		<origin xyz="-0.08 0 -0.04" rpy="${pi / 2.0} 0 0"/>
		<axis xyz="0 1 0"/>
	</joint>

	<link name="caster_wheel">
		<visual>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/visual/edie8_3_caster_wheel.dae"/>
			</geometry>
			<origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
			<!-- <material name="black"/> -->
		</visual>
		<collision>
			<geometry>
				<mesh filename="file://$(find edie_description)/meshes/collision/edie8_3_caster_wheel.stl"/>
			</geometry>
			<origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
			<!-- <material name="black"/> -->
		</collision>
		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<mass value="0.027500956"/> 
			  <inertia ixx="3.2183984e-06" ixy="0.0" ixz="0.0" iyy="5.2677574e-06" iyz="0.0" izz="3.2183987e-06" />
		</inertial>
	</link>

</robot>
