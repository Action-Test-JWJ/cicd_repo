<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- <xacro:macro name="ros2_control" params="use_dummy"> -->

    <ros2_control name="edie8_ros2_control" type="system">
        <hardware>
            <plugin>edie_hardware/EdieHardware</plugin>
            <param name="usb_port">/dev/ttyS8</param>
            <param name="timeout_ms">2000</param>
            <param name="baud_rate">115200</param>
            <param name="enc_counts_per_rev">4096</param>
            <param name="l_wheel_coeff">1.0</param>
            <param name="r_wheel_coeff">1.0</param>
            <param name="leg_limit">90</param>
            <param name="ear_limit">70</param>
        </hardware>

        <!--Wheels-->
        <!-- <joint name="left_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="right_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint> -->

        <!--Legs-->
        <joint name="left_leg_joint">
          <command_interface name="position">
            <param name="min">0</param>
            <param name="max">0.75</param>
          </command_interface>
          <state_interface name="position"/>
        </joint>
        <joint name="right_leg_joint">
          <command_interface name="position">
            <param name="min">0</param>
            <param name="max">0.75</param>
          </command_interface>
          <state_interface name="position"/>
        </joint>

        <!--Ears-->
        <joint name="left_ear_joint">
          <command_interface name="position">
            <param name="min">-3.14</param>
            <param name="max">3.14</param>
          </command_interface>
          <state_interface name="position"/>
        </joint>
        <joint name="right_ear_joint">
          <command_interface name="position">
            <param name="min">-3.14</param>
            <param name="max">3.14</param>
          </command_interface>
          <state_interface name="position"/>
        </joint>
    </ros2_control>

    <ros2_control name="edie8_gimbal" type="system">
    <hardware>
      <plugin>inwheel_motor_hardware/InwheelMotorHardware</plugin>
      <param name="usb_port">can0</param>
      <param name="baud_rate">1000000</param>
      <param name="bus_type">slcan</param>
      <param name="use_dummy">false</param>
      <param name="debug_mode">true</param>
    </hardware>
    <joint name="left_wheel_joint">
      <param name="id">116</param>
      <!-- <param name="motor_model">inwheel</param> -->
      <param name="can_id">16</param> 
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
      <!-- <state_interface name="effort"/> -->
      <!-- <param name="Moter_Constant">0.12</param> -->
      <!-- ???? ?? ???? -->
      <param name="min_vel">0.0</param>
      <param name="max_vel">0.5</param>
    </joint>
    <joint name="right_wheel_joint">
      <param name="id">117</param>
      <!-- <param name="motor_model">inwheel</param> -->
      <param name="can_id">17</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
      <!-- <state_interface name="effort"/> -->
      <!-- <param name="Moter_Constant">0.12</param> -->
      <!-- ???? ?? ???? -->
      <param name="min_vel">0.0</param>
      <param name="max_vel">0.5</param>
    </joint>

    </ros2_control>

  <!-- </xacro:macro> -->
</robot>
