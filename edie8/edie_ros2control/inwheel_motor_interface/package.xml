<?xml version="1.0"?>
<package format="3">
  <name>inwheel_motor_hardware</name>
  <version>0.0.0</version>
  <description>ros2_control hardware for ALICE MOBILE inwheel motors</description>
  <maintainer email="m6488j@arobot4all.com">roscore</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>hardware_interface</depend>
  <depend>transmission_interface</depend>
  <depend>pluginlib</depend>
  <depend>yaml-cpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>aeirobot_toolbox</depend>
  <depend>aeirobot_math</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
