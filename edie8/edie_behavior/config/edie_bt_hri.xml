<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="Main">
      
  <BehaviorTree ID="Main">
    <ReactiveFallback name="root_fallback">
      
      <!-- MANUAL MODE - 세분화된 동작 -->
      <!-- 1번(가장 왼쪽, 최우선) -->
      <!-- 우선순위: remote > follow > home -->
      <ReactiveFallback name="manual_modes">
      
        <!-- Remote Control Mode -->
        <Sequence>
          <IsRobotMode mode="remote"/>
          <IsMotorReady/>
          <RemoteControlPlay/>
        </Sequence>
        
        <!-- Follow Mode -->
        <Sequence>
          <IsRobotMode mode="follow"/>
          <IsMotorReady/>
          <ReactiveFallback name="follow_or_interact">
            <!-- 핵심: 매 틱마다 컨디션을 재평가하려고 ReactiveSequence 사용 -->
            <ReactiveSequence name="follow_until_request">
              <Inverter>
                <IsInteractionRequested/>
              </Inverter>
              <Explore/>
            </ReactiveSequence>
            <TryInteract/>
          </ReactiveFallback>
        </Sequence>
        
        <!-- Home Mode -->
        <Sequence>
          <IsRobotMode mode="home"/>
          <IsMotorReady/>
          <Delay delay_msec="2000">
            <IsStationArrived status="undocked"/>
          </Delay>
          <SubTree ID="HomeMode"/>
        </Sequence>
      </ReactiveFallback>
      
      <!-- AUTO MODE -->
      <!-- 2번(가장 오른쪽, 차선) -->
      <Sequence>
        <IsRobotMode mode="auto"/>
        <IsMotorReady/>
        <ReactiveFallback name="auto_mode_selector">
          <!-- A) 초기화 -->
          <!-- 조건: 배터리 ≥ 20% AND IsHomeInitDone이 아직 False -->
          <!--
          <Sequence name="initialization_home_sequence">
            <IsBatteryChargedAtLeast percent="0.2"/>
            <Inverter>
              <IsHomeInitDone/>
            </Inverter>
            <TryNavigation command="1" status_key="InitHome"/>
            <TryNavigation command="10" status_key="SearchAruco"/>

            <ReactiveFallback name="WaitLocalInit_after_home">
              <IsPoseCorrectionDone/>
              <KeepRunningUntilFailure>
                <Sequence>
                  <TryNavigation command="0" status_key="IdleState"/>
                  <Inverter>
                    <IsPoseCorrectionDone/>
                  </Inverter>
                </Sequence>
              </KeepRunningUntilFailure>
            </ReactiveFallback>

            <Delay delay_msec="1000">
                  <TryNavigation command="5" status_key="RotateBehind"/>
            </Delay>

            <TryNavigation command="0" status_key="IdleState"/>

            <SetHomeInitDone/>
          </Sequence>
          -->

          <!--  B) LOW BATTERY: anywhere in auto mode, go find station [by. HomeMode 서브트리] -->
          <!-- 조건: 배터리 < 20% AND 미도킹 상태 유지(undocked) 2초 -->
          <!--
          <Sequence name="low_battery_go_home">
            <Sequence name="guard_low_battery_and_not_finished">
              <Inverter>
                <IsBatteryChargedAtLeast percent="0.2"/>
              </Inverter>
              <Delay delay_msec="2000">
                <IsStationArrived status="undocked"/>
              </Delay>
            </Sequence>

            <SubTree ID="HomeMode"/>
          </Sequence>
          -->

          <!-- C) BRANCH 1: 초기화가 완료되었으면 메인 루프 실행 -->
          <!-- 조건: 초기화 완료 AND 배터리 ≥ 20%-->
          <Sequence name="main_interaction_loop">
            <!-- <IsHomeInitDone/>
            <IsBatteryChargedAtLeast percent="0.2"/> -->
            <!-- <IfThenElse>
              <SubTree ID="CheckAllFsr"/>
              <ForceSuccess>
                <TryInteract/>
              </ForceSuccess> -->
            <Explore/>
            <!-- </IfThenElse> -->
          </Sequence>

        </ReactiveFallback>
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- SubTree 정의 -->
