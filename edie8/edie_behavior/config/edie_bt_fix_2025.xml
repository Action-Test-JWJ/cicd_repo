<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="Main">

  <BehaviorTree ID="Main">
    <ReactiveFallback name="root_fallback">
      
      <ReactiveFallback name="manual_modes">
      
        <Sequence>
          <IsRobotMode mode="remote"/>
          <IsMotorReady/>
          <SendScanCommand command="false"/>
          <RemoteControlPlay/>
        </Sequence>
        
        <!-- Follow Mode -->
        <Sequence>
          <IsRobotMode mode="follow"/>
          <IsMotorReady/>
          <Inverter>
            <IsLLMState/>
          </Inverter>
          <ReactiveFallback name="follow_logic">

            <!-- [MODIFIED] HIGHEST PRIORITY: React to touch -->
            <ProcessFsrTouch threshold="2000"/>

            <!-- Emotion 모드 실행 -->
            <Sequence name="emotion_mode_action">
              <IsVoraMode mode="emotion"/>
              <ReactiveFallback name="emotion_with_face_check">
                <Sequence name="face_lost_fallback">
                  <Inverter>
                    <IsFaceDetectionActive timeout_sec="10.0"/>
                  </Inverter>
                  <SwitchVoraMode mode="human"/>
                </Sequence>
                <TryInteract/>
              </ReactiveFallback>
            </Sequence>

            <!-- Human 모드 기본 동작 -->
            <ReactiveFallback name="human_mode_default">
              <!-- 1. 랜덤 워크가 필요한 상태 -->
              <Sequence>
                <IsVoraMode mode="human"/>
                <IsRandomWalkNeeded/>
                <ReactiveFallback name="random_walk_logic">

                  <Sequence>
                    <IsHumanVisible/>
                    <ResetRandomWalkFlag/>
                  </Sequence>

                  <TryNavigation command="20" status_key="WanderRandomly"/>
                </ReactiveFallback>
              </Sequence>

              <Sequence>
                <IsVoraMode mode="human"/>
                <Explore/>
              </Sequence>
            </ReactiveFallback>

          </ReactiveFallback>
        </Sequence>
        
        <Sequence>
          <IsRobotMode mode="home"/>
          <IsMotorReady/>
          <Inverter>
            <IsCharging timeout="1.0" status="2"/>
          </Inverter>
          <TryNavigation command="19" status_key="FindAndGoClearing"/>
        </Sequence>

        <Sequence>
          <IsRobotMode mode="llm"/>
          <IsMotorReady/>
        </Sequence>
      </ReactiveFallback>
        
      <!-- AUTO MODE -->
      <Sequence>
        <IsRobotMode mode="auto"/>
        <IsMotorReady/>



      </Sequence>

      <!-- SIM MODE -->
      <Sequence name="ktl_squence">
        <IsRobotMode mode="sim"/>
        <IsMotorReady/>
        <SubTree ID="GoTo0Marker"/>
        
        <SubTree ID="PoseCorrect"/>
        <TryNavigation command="3" status_key="GoToPreAlignPose"/>
        <!-- AlignToStation 전에 측면 위치로 이동 -->
        <TryNavigation command="17" status_key="GoToSideInit"/>
        <TryNavigation command="4" status_key="AlignToStation"/>
        <SubTree ID="PoseCorrect"/>
        <Docking dock_id="charging_station_1"/>
      </Sequence>


    </ReactiveFallback>

  </BehaviorTree>

  <BehaviorTree ID="GoTo0Marker">
    <Sequence name="search_and_approach_marker_0">
      <TryNavigation command="10" status_key="SearchAruco"/>
      <Fallback>
        <Timeout msec="10000">
          <SubTree ID="PoseCorrect"/>
        </Timeout>
        <Sequence>
          <CollectArucoPoseData sample_count="100"/>
          
          <!-- 평균 pose를 기반으로 로봇이 어느 영역에 있는지 확인 후 이동 -->
          <Fallback name="AreaClassification">
            <Sequence name="GoLeftIfNeeded">
              <IsRobotInArea area="left"/>
              <SetTargetMarkerId marker_id="301"/>
              <TryNavigation command="13" status_key="ApproachMarker"/>
              <SubTree ID="PoseCorrect"/>
            </Sequence>
            <Sequence name="GoRightIfNeeded">
              <IsRobotInArea area="right"/>
              <SetTargetMarkerId marker_id="101"/>
              <TryNavigation command="13" status_key="ApproachMarker"/>
              <SubTree ID="PoseCorrect"/>
            </Sequence>
            <AlwaysSuccess/>
          </Fallback>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="PoseCorrect">
    <ReactiveFallback name="WaitLocalInit_after_home">
      <IsPoseCorrectionDone/>
      <KeepRunningUntilFailure>
        <Sequence>
          <TryNavigation command="0" status_key="IdleState"/>
          <Inverter>
            <IsPoseCorrectionDone/>
          </Inverter>
        </Sequence>
      </KeepRunningUntilFailure>
    </ReactiveFallback>
  </BehaviorTree>
  
  <!-- (Other SubTrees like HomeMode) -->

  <TreeNodesModel>
    <!-- (Other node definitions) -->
    <Action ID="FindClosestMarker" editable="true">
      <output_port name="found_marker_id" type="std::string">ID of the closest marker</output_port>
    </Action>
    <Action ID="SetTargetMarkerId" editable="true">
      <input_port name="marker_id" type="std::string">Target marker ID to search for</input_port>
    </Action>
    <Action ID="Docking" editable="true">
      <input_port name="dock_id" type="std::string">Dock ID to dock to</input_port>
    </Action>
    <Action ID="CollectArucoPoseData" editable="true">
      <input_port name="sample_count" type="int" default="100">Number of pose samples to collect</input_port>
    </Action>
    <Condition ID="IsRobotInArea" editable="true">
      <input_port name="area" type="std::string">Area to check: station_front, station_side, station_side_left, station_side_right</input_port>
    </Condition>
    <Condition ID="IsCharging" editable="true">
      <input_port name="timeout" type="double" default="1.0">Timeout in seconds</input_port>
      <input_port name="status" type="int" default="2">Expected charging status</input_port>
    </Condition>
    <!-- (Other node definitions) -->

    <!-- # ===== Command indices =====
    CMD_IDLE                           IdleState            = 0
    CMD_INIT_HOME                      InitHome             = 1
    CMD_SPIN_ONCE                      SpinOnce             = 2
    CMD_GO_TO_PRE_ALIGN_POSE           GoToPreAlignPose     = 3 
    CMD_ALIGNMENT                      AlignToStation       = 4
    CMD_ROTATE_BEHIND                  RotateBehind         = 5
    CMD_GO_BACK                        GoBack               = 6
    CMD_FIND_STATION_INIT              FindStationForInit   = 7
    CMD_FIND_STATION_CHARGE            FindStationForCharge = 8
    CMD_MOVE_RANDOMLY                  MoveRandomly         = 9
    CMD_SEARCH_ARUCO                   SearchAruco          = 10
    CMD_APPROACH_STATION               ApproachStation      = 11
    CMD_GO_TO_MIDDLE                   GoToMiddle           = 12
    CMD_APPROACH_MARKER                ApproachMarker       = 13
    CMD_GO_TO_SIDE_LEFT                GoToSideLeft         = 14
    CMD_GO_TO_SIDE_RIGHT               GoToSideRight        = 15
    CMD_GO_TO_FRONT                    GoToFront            = 16
    CMD_GO_TO_SIDE_INIT                GoToSideInit         = 17
    CMD_ALIGN_YAW_TO_ZERO              AlignYawToZero       = 18 -->

  </TreeNodesModel>

</root>
